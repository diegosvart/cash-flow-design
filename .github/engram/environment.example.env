# Engram MCP Configuration for cash-flow-design
# Copiar a ~/.engram/.env y ajustar rutas según sistema local

# Engram Project Naming (canonical)
ENGRAM_PROJECT=cash-flow-design
ENGRAM_VERSION=1.0

# Database Location (Windows path)
ENGRAM_DB_PATH=C:\Users\%USERNAME%\AppData\Local\Engram\cash-flow-design

# FTS5 SQLite Configuration
ENGRAM_FTS_ENABLED=true
ENGRAM_SEARCH_MODE=semantic

# VS Code MCP Server Settings
VSCODE_MCP_PORT=8765
VSCODE_MCP_LOG_LEVEL=debug

# Memory Protocol Settings
MEMORY_LAYER=3-tier
  - Layer 1: /memories/repo/ (permanent, curated decisions)
  - Layer 2: /memories/session/ (ephemeral, active plan context)
  - Layer 3: Engram (persistent searchable, timeline, cross-session context)

# MCP Commands Available to Agent
MCP_ENABLED_COMMANDS=mem_search,mem_save,mem_context,mem_session_summary,mem_timeline

# Sync Strategy
SYNC_STRATEGY=partial
  - Engram syncs `/memories/repo/planning_policy.md` automatically
  - `/memories/session/plan.md` NOT synced (ephemeral per session)
  - Figma design references indexed into Engram FTS
